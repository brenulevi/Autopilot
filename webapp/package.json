{
  "name": "autopilot-mission-planner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "native": "cmake -S native -B .native-build -DCMAKE_BUILD_TYPE=Release && cmake --build .native-build --config Release",
    "dev": "npm run native && tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run native && npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js --production",
    "test": "npm run native && tsx --test tests/*.test.ts",
    "telemetry:demo": "tsx scripts/demo-telemetry.ts",
    "telemetry:csv": "tsx scripts/stream-csv.ts",
    "telemetry:sim": "tsx scripts/stream-sim.ts",
    "mission:compile": "tsx scripts/compile.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
