{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Teste de roll (simulação)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/host/bin/Debug/autopilot_sim",
      "args": [
        "--mode",
        "roll-hold",
        "--bank-deg",
        "5",
        "--roll-kp",
        "4.0",
        "--roll-kd",
        "0.5",
        "--duration",
        "20",
        "--airspeed-kts",
        "100",
        "--flightgear",
        "--output",
        "${workspaceFolder}/logs/c172x_roll_hold.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "autopilot: build sim"
    },
    {
      "name": "Teste de pitch (simulação)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/host/bin/Debug/autopilot_sim",
      "args": [
        "--mode",
        "pitch-hold",
        "--pitch-deg",
        "2",
        "--pitch-kp",
        "10.0",
        "--pitch-kd",
        "3.0",
        "--duration",
        "20",
        "--airspeed-kts",
        "100",
        "--flightgear",
        "--output",
        "${workspaceFolder}/logs/c172x_pitch_hold.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "autopilot: build sim"
    },
    {
      "name": "Plot Python: roll",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/plot_logs.py",
      "args": [
        "--roll-hold",
        "--experiment",
        "${workspaceFolder}/logs/c172x_roll_hold.csv",
        "--settling-band-deg",
        "0.25",
        "--output",
        "${workspaceFolder}/logs/plots/c172x_roll_hold"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Plot Python: pitch",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/plot_logs.py",
      "args": [
        "--pitch-hold",
        "--experiment",
        "${workspaceFolder}/logs/c172x_pitch_hold.csv",
        "--output",
        "${workspaceFolder}/logs/plots/c172x_pitch_hold"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Varredura + plots: roll",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/sweep_attitude.py",
      "args": [
        "--axis",
        "roll",
        "--sim",
        "${workspaceFolder}/build/host/bin/Debug/autopilot_sim",
        "--speeds",
        "60",
        "75",
        "90",
        "100",
        "110",
        "--angles",
        "5",
        "-5",
        "10",
        "-10",
        "15",
        "-15",
        "30",
        "-30",
        "--angle-limit-deg",
        "30",
        "--kp",
        "4.0",
        "--kd",
        "0.5",
        "--duration",
        "20",
        "--settling-band-deg",
        "0.25",
        "--output-dir",
        "${workspaceFolder}/logs/sweeps"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "autopilot: build sim"
    },
    {
      "name": "Varredura + plots: pitch",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/sweep_attitude.py",
      "args": [
        "--axis",
        "pitch",
        "--sim",
        "${workspaceFolder}/build/host/bin/Debug/autopilot_sim",
        "--speeds",
        "60",
        "75",
        "90",
        "100",
        "110",
        "--angles",
        "5",
        "-5",
        "10",
        "-10",
        "15",
        "-15",
        "30",
        "-30",
        "--angle-limit-deg",
        "45",
        "--kp",
        "10.0",
        "--kd",
        "3.0",
        "--duration",
        "20",
        "--settling-band-deg",
        "0.25",
        "--output-dir",
        "${workspaceFolder}/logs/sweeps"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "autopilot: build sim"
    },
    {
      "name": "FlightGear (visualização)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/games/fgfs",
      "args": [
        "--launcher=no",
        "--aircraft=c172p",
        "--fdm=null",
        "--native-fdm=socket,in,50,,5600,udp",
        "--lat=30",
        "--lon=0",
        "--altitude=3000"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "FlightGear (missão web)",
      "type": "cppdbg",
      "request": "launch",
      "program": "/usr/games/fgfs",
      "args": [
        "--launcher=no",
        "--aircraft=c172p",
        "--fdm=null",
        "--native-fdm=socket,in,50,,5600,udp",
        "--lat=-27.1453118",
        "--lon=-52.6025391",
        "--altitude=3000"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb"
    },
    {
      "name": "Compilar missão",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/tools/compile_mission.py",
      "args": [
        "${workspaceFolder}/missions/c172x_turns.json",
        "${workspaceFolder}/logs/c172x_turns.apm"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Missão (simulação)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/host/bin/Debug/autopilot_sim",
      "args": [
        "--mode",
        "mission",
        "--mission",
        "${workspaceFolder}/logs/c172x_turns.apm",
        "--duration",
        "120",
        "--flightgear",
        "--output",
        "${workspaceFolder}/logs/c172x_mission.csv"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "externalConsole": false,
      "MIMode": "gdb",
      "preLaunchTask": "autopilot: compile mission"
    },
    {
      "name": "Telemetry: mission to web map",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/webapp/scripts/stream-sim.ts",
      "args": [
        "--mode", "mission",
        "--mission", "${workspaceFolder}/logs/mission.apm",
        "--start-lat-deg", "-27.1453118",
        "--start-lon-deg", "-52.6025391",
        "--start-heading-deg", "345.64",
        "--flightgear",
        "--duration", "600",
        "--output", "${workspaceFolder}/logs/mission.csv"
      ],
      "cwd": "${workspaceFolder}/webapp",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": { "TELEMETRY_PORT": "5601" },
      "preLaunchTask": "autopilot: build sim"
    },
    {
      "name": "Webapp: mission planner",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "${workspaceFolder}/webapp",
      "console": "integratedTerminal",
      "skipFiles": [
        "<node_internals>/**"
      ],
      "env": {
        "PORT": "3001",
        "TELEMETRY_PORT": "5601"
      },
      "serverReadyAction": {
        "pattern": "Mission planner: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "Webapp + mission telemetry",
      "configurations": [
        "Webapp: mission planner",
        "Telemetry: mission to web map"
      ],
      "stopAll": true
    },
    {
      "name": "Webapp + FlightGear + mission",
      "configurations": [
        "Webapp: mission planner",
        "FlightGear (missão web)",
        "Telemetry: mission to web map"
      ],
      "stopAll": true
    },
    {
      "name": "Roll + FlightGear",
      "configurations": [
        "FlightGear (visualização)",
        "Teste de roll (simulação)"
      ],
      "stopAll": true
    },
    {
      "name": "Pitch + FlightGear",
      "configurations": [
        "FlightGear (visualização)",
        "Teste de pitch (simulação)"
      ],
      "stopAll": true
    },
    {
      "name": "Missão + FlightGear",
      "configurations": [
        "FlightGear (visualização)",
        "Missão (simulação)"
      ],
      "stopAll": true
    }
  ]
}
